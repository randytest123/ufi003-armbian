# --- 20. Round 10 尺寸兜底: 优化级别改成 size ---
# defconfig 默认 CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=y (-O2).
# 实测 -O2 下即使裁掉上所有驱动, Image 预估仍在 31~35 MB (> 28 MB 上限),
# 因此直接切到 -Os (只影响代码体积/速度取舍, 不影响功能与启动).
# 如后续实测 Image <= 26 MB 且有性能诉求, 可删掉本段两行回到 -O2.
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_CC_OPTIMIZE_FOR_PERFORMANCE=n

# =============================================================================
# Round 10 尺寸预算 (2026-11-07)
#   现状: Image 解压后 52,387,848 B (49.96 MiB), gzip 后 kernel_size 17,916,075 B
#   目标: Image <= 28 MiB (0x80080000 + 28MiB = 0x81C00000 < tags 0x81E00000)
#         boot.img <= 30 MiB (page 2048 + r4(kernel) + r4(ramdisk))
#
#   裁掉的部分 (按 batch 编号):
#     #1  43 个非 QCOM 平台            -> 只留 ARCH_QCOM
#     #2  XEN/KVM/VFIO/PCI/ACPI/IOMMU/KEXEC/CRASH/HIBERNATION/NUMA/KSM
#     #3  IPv6/netfilter/bridge/VLAN/CAN/BT/NFC/QRTR + 全部以太网与 PHY
#     #4  MTD/SATA/SCSI/UFS/NVMe + 非 MSM 串口
#     #5  I2C/SPI 非 QUP 驱动
#     #6  pinctrl/GPIO 非 MSM 平台
#     #7  DRM/FB/backlight/SOUND/MEDIA/触摸 + USB 主机/存储/串口 + 非 MSM MMC
#     #8  时钟/稳压/热/wdt/MFD/RTC/PWM/DMA 非 QCOM + 电池/充电/IIO
#     #9  文件系统: 只留 ext4/tmpfs/devtmpfs/configfs/overlayfs, 其余 =n 或 =m
#     #10 调试/跟踪/测试/BPF/KUnit/KALLSYMS_ALL/IKCONFIG/CORESIGHT
#     #11 平台残留: cpufreq/PHY/NVMEM/PMU/interconnect/HTE 等
#     #19 crypto test / GNSS
#
#   预估 (同一 toolchain):
#     -O2 + 上述裁剪 : 31 ~ 35 MiB  (仍超 28 MiB)
#     -Os + 上述裁剪 : 24 ~ 28 MiB  (目标区间, 余量 0~4 MiB)
#     gzip -9 之后 kernel_size 预计 8.5 ~ 10.5 MiB,
#     boot.img 总长预计 2100(页对齐) + gz+dtb + 14,493,696 ~ 24 ~ 27 MiB.
#
#   必须保留 (启动链 / 后续要用): ARCH_QCOM, MSM_GCC_8916, QCOM_CLK_SMD_RPM,
#   PINCTRL_MSM8916, QCOM_SMD_RPM, QCOM_SMEM, QCOM_SMP2P, QCOM_TSENS, QCOM_WDT,
#   REGULATOR_QCOM_SMD_RPM/SPMI, MFD_SPMI_PMIC, RTC_DRV_PM8XXX, MMC_SDHCI_MSM,
#   USB_DWC3 + USB_GADGET + USB_CONFIGFS(RNDIS/ACM), PHY_QCOM_QUSB2,
#   SERIAL_MSM(_CONSOLE), I2C_QUP, SPI_QUP, EXT4_FS, BLK_DEV_INITRD,
#   DEVTMPFS(_MOUNT), OVERLAY_FS, CONFIGFS_FS, EXTCON_USB_GPIO, LEDS_GPIO,
#   INPUT_KEYBOARD/KEYBOARD_GPIO, POWER_RESET_MSM, REMOTEPROC/QCOM_WCNSS_PIL,
