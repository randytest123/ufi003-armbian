--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-handsome-openstick-ufi003.dts
@@ -0,0 +1,69 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Handsome OpenStick UFI003 (MSM8916) — modem-free variant
+ *
+ * Hardware: Qualcomm MSM8916, 512MB RAM, 4GB eMMC, WCN3620 WiFi,
+ *           USB 2.0 OTG (PM8916 USBIN role switch), UART on blsp_uart2.
+ *
+ * Based on mainline msm8916-ufi.dtsi (same board family as thwc-ufi001c).
+ * Differences vs thwc-ufi001c:
+ *   - model/compatible = handsome,ufi003
+ *   - modem (mss-pil) and its reserved-memory regions disabled:
+ *     there is no closed-source modem firmware in this build, and loading
+ *     mss-pil without firmware hangs the boot.
+ *   - WiFi (wcnss / WCN3620) stays enabled — it is independent of the modem.
+ *
+ * GPIO map (from the stock boot.img DTB):
+ *   reset button : gpio37 (active high, internal pull-up)
+ *   LED blue  (wifi)    : gpio20
+ *   LED green (internet): gpio21
+ *   LED red   (os)      : gpio22
+ *   SIM ctrl gpio0..3   : not used (modem disabled)
+ */
+
+/dts-v1/;
+
+#include "msm8916-ufi.dtsi"
+
+/ {
+	model = "Handsome OpenStick UFI003";
+	compatible = "handsome,ufi003", "qcom,msm8916";
+};
+
+&button_restart {
+	gpios = <&tlmm 37 GPIO_ACTIVE_HIGH>;
+};
+
+&led_b {
+	gpios = <&tlmm 20 GPIO_ACTIVE_HIGH>;
+};
+
+&led_g {
+	gpios = <&tlmm 21 GPIO_ACTIVE_HIGH>;
+};
+
+&led_r {
+	gpios = <&tlmm 22 GPIO_ACTIVE_HIGH>;
+};
+
+/* No modem firmware in this image: keep mss-pil and its memory regions off */
+&mpss {
+	status = "disabled";
+};
+
+&mpss_mem {
+	status = "disabled";
+};
+
+&mba_mem {
+	status = "disabled";
+};
+
+&button_default {
+	pins = "gpio37";
+	bias-pull-up;
+};
+
+&gpio_leds_default {
+	pins = "gpio20", "gpio21", "gpio22";
+};
