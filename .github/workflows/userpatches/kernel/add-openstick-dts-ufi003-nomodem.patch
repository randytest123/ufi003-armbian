diff --git a/arch/arm64/boot/dts/qcom/msm8916-handsome-openstick-common.dtsi b/arch/arm64/boot/dts/qcom/msm8916-handsome-openstick-common.dtsi
new file mode 100644
index 0000000..xxxxxxxx
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-handsome-openstick-common.dtsi
@@ -0,0 +1,248 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Copyright (C) 2021-2022 HandsomeYingyan <handsomeyingyan@gmail.com>
+ * Copyright (C) 2024  (UFI003 modem-disable variant)
+ *
+ * Common DTSI for Handsome OpenStick family (Qualcomm MSM8916)
+ * All devices share the same base hardware:
+ *   - Cortex-A53 x4, 512MB RAM
+ *   - 4GB eMMC (sdhc1)
+ *   - WCN3620 WiFi (pronto-v2-pil remoteproc)
+ *   - Qualcomm MDM modem (mss-pil remoteproc)
+ *
+ * This variant disables the modem PIL and its shared memory regions,
+ * keeping only WiFi. Required for building Armbian images without
+ * closed-source modem firmware.
+ */
+
+/dts-v1/;
+
+#include "msm8916-pm8916.dtsi"
+#include <dt-bindings/gpio/gpio.h>
+#include <dt-bindings/input/input.h>
+
+/ {
+       model = "Handsome Openstick Generic";
+       compatible = "handsome,openstick", "qcom,msm8916", "lk2nd,device";
+
+       aliases {
+               serial0 = &blsp1_uart2;
+       };
+
+       chosen {
+               stdout-path = "serial0";
+       };
+
+       reserved-memory {
+               /delete-node/ wcnss@89300000;
+               /delete-node/ venus@89900000;
+
+               /* Modem firmware load region - disabled (no modem firmware) */
+               mpss_mem: mpss@86800000 {
+                       status = "disabled";
+                       reg = <0x0 0x86800000 0x0 0x5500000>;
+                       no-map;
+               };
+
+               /* Modem RMTFS shared memory - disabled */
+               rmtfs_mem: rmtfs@86700000 {
+                       status = "disabled";
+                       reg = <0x0 0x86700000 0x0 0xE0000>;
+                       no-map;
+               };
+
+               /* Modem MBA (Modem Boot Assembler) region - disabled */
+               mba_mem: mba@8ea00000 {
+                       status = "disabled";
+                       reg = <0x0 0x8ea00000 0x0 0x100000>;
+                       no-map;
+               };
+
+               /* RFSA - disabled */
+               rfsa_mem: rfsa@867e0000 {
+                       status = "disabled";
+                       reg = <0x0 0x867e0000 0x0 0x20000>;
+                       no-map;
+               };
+
+               /* WiFi firmware load region - KEEP */
+               wcnss_mem: wcnss@8df00000 {
+                       reg = <0x0 0x8df00000 0x0 0x600000>;
+                       no-map;
+               };
+       };
+
+       usb_id: usb-id {
+               compatible = "linux,extcon-usb-gpio";
+               id-gpio = <&msmgpio 110 GPIO_ACTIVE_HIGH>;
+               pinctrl-names = "default";
+               pinctrl-0 = <&usb_id_default>;
+       };
+};
+
+/*
+ * Modem shared memory interface — disabled.
+ * The modem firmware sends a "query_size" memshare request for client ID 1,
+ * but does nothing with it. GPS/modem not needed on pure compute node.
+ */
+&memshare {
+       status = "disabled";
+};
+
+/*
+ * Modem PIL (Peripheral Image Loader) — disabled.
+ * This is the main controller that loads mba + mpss firmware blobs.
+ * Without closed-source firmware, loading it causes boot hangs.
+ * Label name in mainline dtsi may be: modem_pronto / pronto_modem / mss@0.
+ * We try multiple possible labels.
+ */
+&pronto_modem {
+       status = "disabled";
+};
+
+/* WiFi PIL — KEEP (WCN3620/3660B firmware lives here) */
+&pronto {
+       status = "okay";
+};
+
+&blsp_dma {
+       status = "okay";
+};
+
+&blsp1_uart2 {
+       status = "okay";
+};
+
+&lpass {
+       status = "okay";
+};
+
+&sdhc_1 {
+       status = "okay";
+       pinctrl-names = "default", "sleep";
+       pinctrl-0 = <&sdc1_clk_on &sdc1_cmd_on &sdc1_data_on>;
+       pinctrl-1 = <&sdc1_clk_off &sdc1_cmd_off &sdc1_data_off>;
+};
+
+&sound {
+       status = "disabled";
+};
+
+&usb {
+       status = "okay";
+       extcon = <&usb_id>, <&usb_id>;
+};
+
+&usb_hs_phy {
+       v1p8-supply = <&pm8916_l7>;
+       v3p3-supply = <&pm8916_l13>;
+       extcon = <&usb_id>;
+};
+
+&msmgpio {
+       usb_id_default: usb-id-default {
+               pins = "gpio110";
+               function = "gpio";
+               drive-strength = <8>;
+               input-enable;
+               bias-pull-up;
+       };
+};
+
+&smd_rpm_regulators {
+       vdd_l1_l2_l3-supply = <&pm8916_s3>;
+       vdd_l4_l5_l6-supply = <&pm8916_s4>;
+       vdd_l7-supply = <&pm8916_s4>;
+
+       s3 { regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1300000>; };
+       s4 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <2100000>; };
+       l1 { regulator-min-microvolt = <1225000>; regulator-max-microvolt = <1225000>; };
+       l2 { regulator-min-microvolt = <1200000>; regulator-max-microvolt = <1200000>; };
+       l4 { regulator-min-microvolt = <2050000>; regulator-max-microvolt = <2050000>; };
+       l5 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; };
+       l6 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; };
+       l7 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <1800000>; };
+       l8 { regulator-min-microvolt = <2850000>; regulator-max-microvolt = <2900000>; };
+       l9 { regulator-min-microvolt = <3300000>; regulator-max-microvolt = <3300000>; };
+       l10 { regulator-min-microvolt = <2700000>; regulator-max-microvolt = <2800000>; };
+       l11 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <2950000>; regulator-allow-set-load; regulator-system-load = <200000>; };
+       l12 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <2950000>; };
+       l13 { regulator-min-microvolt = <3075000>; regulator-max-microvolt = <3075000>; };
+       l14 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <3300000>; };
+       l15 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <3300000>; };
+       l16 { regulator-min-microvolt = <1800000>; regulator-max-microvolt = <3300000>; };
+       l17 { regulator-min-microvolt = <2850000>; regulator-max-microvolt = <2850000>; regulator-always-on; };
+       l18 { regulator-min-microvolt = <2700000>; regulator-max-microvolt = <2700000>; };
+};
+
+/* HACK: modem.dtsi must come after so we can override its defaults */
+#include "msm8916-modem.dtsi"
+
+/*
+ * After including modem.dtsi, explicitly disable the modem PIL main node.
+ * The label may vary by kernel version:
+ *   - modem:       /soc/remoteproc@4080000 (compatible: qcom,msm8916-mss-pil)
+ *   - WiFi:        /soc/remoteproc@a21b000 (compatible: qcom,pronto-v2-pil) — KEEP
+ */
+/ {
+       soc {
+               remoteproc@4080000 {
+                       status = "disabled";
+               };
+       };
+};
diff --git a/arch/arm64/boot/dts/qcom/msm8916-handsome-openstick-ufi003.dts b/arch/arm64/boot/dts/qcom/msm8916-handsome-openstick-ufi003.dts
new file mode 100644
index 0000000..xxxxxxxx
--- /dev/null
+++ b/arch/arm64/boot/dts/qcom/msm8916-handsome-openstick-ufi003.dts
@@ -0,0 +1,101 @@
+// SPDX-License-Identifier: GPL-2.0-only
+/*
+ * Handsome OpenStick UFI003 — USB LTE Modem Stick (dual-SIM variant)
+ * Copyright (C) 2024
+ *
+ * Hardware is identical to UFI001C (dual-SIM, same GPIO assignment).
+ * The only difference is model string: "Handsome OpenStick jsbsbxjxh66-bianyi UFI003"
+ * GPIO mapping (from original boot.img DTB):
+ *   Reset button: gpio37 (tlmm block 62 pin 37 — ACTIVE_LOW = 1)
+ *   LEDs:         blue:wifi=gpio20, green:internet=gpio21, red:os=gpio22
+ *   SIM control:  sim_sel=gpio2, sim_en=gpio1, sim_sel2=gpio0, sim_en2=gpio3
+ * USB role:      gpio110 active-high (linux,extcon-usb-gpio)
+ * WiFi:          WCN3620 (pronto-v2-pil iris)
+ * UART:          blsp_uart2 @ 0x78b0000 (serial console)
+ * eMMC:          sdhc1 (sdhci@7824000), 8-bit, non-removable
+ */
+
+/dts-v1/;
+#include "msm8916-handsome-openstick-common.dtsi"
+
+/ {
+       model = "Handsome OpenStick UFI003";
+       compatible = "handsome,openstick", "qcom,msm8916";
+
+       gpio-keys {
+               compatible = "gpio-keys";
+               #address-cells = <1>;
+               #size-cells = <0>;
+               autorepeat;
+               pinctrl-names = "default";
+               pinctrl-0 = <&gpio_keys_default>;
+               label = "GPIO Buttons";
+               reset {
+                       label = "Restart";
+                       gpios = <&msmgpio 37 GPIO_ACTIVE_LOW>;
+                       linux,code = <KEY_RESTART>;
+               };
+       };
+
+       leds {
+               pinctrl-names = "default";
+               pinctrl-0 = <&msmgpio_leds>;
+               compatible = "gpio-leds";
+
+               wifi {
+                       label = "blue:wifi";
+                       gpios = <&msmgpio 20 GPIO_ACTIVE_HIGH>;
+                       linux,default-trigger = "phy0tx";
+                       default-state = "off";
+               };
+
+               internet {
+                       label = "green:internet";
+                       gpios = <&msmgpio 21 GPIO_ACTIVE_HIGH>;
+                       default-state = "off";
+               };
+
+               os {
+                       label = "red:os";
+                       gpios = <&msmgpio 22 GPIO_ACTIVE_HIGH>;
+                       linux,default-trigger = "heartbeat";
+                       default-state = "on";
+               };
+
+               /*
+                * Dual-SIM control LEDs. Kept but default off
+                * since we're building a modem-free Armbian image.
+                * Can be re-enabled if modem firmware is installed later.
+                */
+               sim_sel {
+                       label = "sim:sel";
+                       gpios = <&msmgpio 2 GPIO_ACTIVE_HIGH>;
+                       default-state = "off";
+               };
+               sim_en {
+                       label = "sim:en";
+                       gpios = <&msmgpio 1 GPIO_ACTIVE_HIGH>;
+                       default-state = "off";
+               };
+               sim_sel2 {
+                       label = "sim:sel2";
+                       gpios = <&msmgpio 0 GPIO_ACTIVE_HIGH>;
+                       default-state = "off";
+               };
+               sim_en2 {
+                       label = "sim:en2";
+                       gpios = <&msmgpio 3 GPIO_ACTIVE_HIGH>;
+                       default-state = "off";
+               };
+       };
+};
+
+&msmgpio {
+       msmgpio_leds: msmgpio-leds {
+               pins = "gpio0","gpio1","gpio2","gpio3","gpio20","gpio21","gpio22";
+               function = "gpio";
+               bias-disabled;
+       };
+
+       gpio_keys_default: gpio_keys_default {
+               pins = "gpio37";
+               function = "gpio";
+               drive-strength = <8>;
+               input-enable;
+               bias-pull-up;
+       };
+};
+
+/* WiFi chip: WCN3620 (matches original firmware's iris compatible) */
+&pronto {
+       iris {
+               compatible = "qcom,wcn3620";
+       };
+};
+
