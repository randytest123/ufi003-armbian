# =============================================================================
# MSM8916 (Qualcomm Snapdragon 410) — kernel config fragment
# 适用: UFI003 OpenStick (无 modem 版)
#
# ⚠️ 这个文件**不会被 Armbian 自动读取**!
#   由 scripts/gen-kernel-config.sh 手动读取.
#   流程: make ARCH=arm64 defconfig → 追加本文件 → make olddefconfig.
#
#   armbian-next (2025+) 不再使用 KERNEL_CONFIG_FRAGMENTS 机制.
#   armbian 内部的 kernel-config.sh 用 prepare_kernel_config_core_or_userpatches
#   直接找完整 .config 文件, 不做 defconfig+fragment merge.
#
# 所有符号名核实自 Linux v6.12 源码:
#   arch/arm64/configs/defconfig, drivers/remoteproc/Kconfig,
#   drivers/rpmsg/Kconfig, drivers/power/reset/Kconfig, drivers/usb/gadget/Kconfig
#
# 主线 arm64 defconfig 已开启的 (不需要再写):
#   CONFIG_ARCH_QCOM=y     (L62)
#   CONFIG_WCN36XX=m       (L419, WiFi driver)
#   CONFIG_CFG80211=m      (L199)
#   CONFIG_MAC80211=m      (L200)
#   CONFIG_PINCTRL_MSM8916=y (L602)
#   CONFIG_SERIAL_MSM=y    (L489, msm8916 用的 UART)
#   CONFIG_SERIAL_MSM_CONSOLE=y (L490)
#   CONFIG_SERIAL_QCOM_GENI=y   (L491, 8996+ 的新 IP)
#   CONFIG_SERIAL_QCOM_GENI_CONSOLE=y (L492)
#   CONFIG_RPMSG_QCOM_SMD=m  (rpmsg/Kconfig, base 会选)
#   CONFIG_BLK_DEV_INITRD=y  (L30)
#   CONFIG_DEVTMPFS=y        (L245)
#
# =============================================================================

# --- WiFi/BT (WCN3620) PIL 加载器 ---
# WCNSS PIL loader: msm8916 通过 QCOM_WCNSS_PIL 加载 wcnss.b00~b11 firmware
# remoteproc/Kconfig L234-250 明确支持 MSM8916
CONFIG_REMOTEPROC=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_WCNSS_PIL=m

# --- Modem PIL (虽然禁 modem, 但 PIL 框架 + ADSP/ADSP 子系统 还是需要) ---
CONFIG_QCOM_Q6V5_ADSP=m
# 不写 CONFIG_QCOM_Q6V5_MSS — modem disabled, 不做 PIL

# --- SMD / Glink / RPMSG 通信通道 ---
# WiFi PIL 需要 RPMSG_QCOM_SMD 或 RPMSG_QCOM_GLINK_SMEM 之一
CONFIG_RPMSG_QCOM_SMD=m

# --- USB gadget (RNDIS + ACM, 让主机通过 USB 上网/SSH) ---
# USB gadget/Kconfig v6.12 确认:
#   L180:  USB_CONFIGFS (configfs framework)
#   L248:  USB_CONFIGFS_RNDIS (没有 F_ 前缀!)
#   L199:  USB_CONFIGFS_ACM (没有 F_ 前缀!)
#   L153:  USB_F_RNDIS (legacy, 有 F_ 前缀, 不用这个)
#   L129:  USB_F_ACM (legacy, 有 F_ 前缀, 不用这个)
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_ACM=y

# --- eMMC ---
# CONFIG_MMC=y base 已有
CONFIG_MMC_SDHCI_PLTFM=y

# --- QCOM pin controller (除 pinctrl_msm8916 外的通用 pinctrl) ---
# CONFIG_PINCTRL_QCOM_SPM_V2=y   # v6.12 已并入 CONFIG_PINCTRL_MSM=y

# --- QCOM regulators ---
# CONFIG_REGULATOR_QCOM_SMD_RPM 由 Kconfig select 自动开启 (QCOM_WCNSS_PIL 依赖 QCOM_SMEM)
# 如果 msm8916 实际 boot 时 regulator 缺失, 在 olddefconfig 后手动补

# --- USB role detection (extcon) ---
# CONFIG_EXTCON=y / CONFIG_EXTCON_GPIO=y 不确定 v6.12 符号名, 让 olddefconfig 自动选

# --- 其他 ----
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_LEDS_GPIO=y
CONFIG_OVERLAY_FS=y
CONFIG_PRINTK_TIME=y
# CONFIG_BLK_DEV_DM 统一在 batch4 段设成 =m (见 "# --- 6. 存储 ---")

# --- 刻意不开启的 (无 modem 版) ---
# CONFIG_QCOM_Q6V5_MSS is not set    ← modem PIL 不做
# CONFIG_USB_CONFIGFS_F_FS is not set ← USB functionFS (不用)

# =============================================================================
# Round 9: 强制关闭 EFI —— 这条设备走 Qualcomm aboot, 不走 UEFI.
#
# 根因: arm64 defconfig 默认 EFI=y / EFI_STUB=y, 产出的 Image 是 PE/COFF
# 可执行文件 (首字节 'MZ', e_lfanew=64). aboot 不校验格式, 原样搬到
# 0x80080000 跳转 → 第一条指令非法 → 复位 → 停在 9006.
#
# 关掉后 arch/arm64/boot/Image 才是标准裸 Image:
#   code0 = 0xd503201f (NOP)
#   code1 = b primary_entry
#
# 注意: 这些行由 gen-kernel-config.sh 追加到 .config 末尾,
# 会覆盖 base defconfig 里的 EFI=y / EFI_STUB=y;
# olddefconfig 之后脚本会硬校验必须是 =n, 若被其他符号 select
# 则打印 select 它的符号并直接失败 (不硬改到构建失败).
# =============================================================================
CONFIG_EFI=n
CONFIG_EFI_STUB=n
CONFIG_EFI_ARMSTUB=n
CONFIG_EFI_ZBOOT=n

# =============================================================================
# Round 10: 内核瘦身 (52,387,848 B → 目标 <= 28 MiB)
#
# 动机: aboot 的 boot_linux_from_mmc 解压后立刻
#   update_ker_tags_rdisk_addr() + ROUND_TO_PAGE + 地址重叠检查,
#   把内核按 0x80080000 摆放, tags 固定 0x81E00000、ramdisk 固定 0x82000000.
#   Image 必须 <= 28 MiB: 0x80080000 + 28 MiB = 0x81C00000 < 0x81E00000.
#
# 做法: 主线 arm64 defconfig 是多平台通用内核 (40+ ARCH_*, 平台驱动全 =y).
# 这里只留 ARCH_QCOM + msm8916 启动链路, 其余一律关掉.
#
# --- 必须保留 (启动链路, 不要动) ---
#   ARCH_QCOM / COMMON_CLK_QCOM / PINCTRL_MSM / PINCTRL_MSM8916
#   MMC_SDHCI_MSM / SERIAL_MSM(+CONSOLE) / I2C_QUP / SPI_QUP
#   QCOM_SMEM / QCOM_SMD_RPM / REGULATOR_QCOM_SMD_RPM / REGULATOR_QCOM_SPMI
#   REGULATOR_FIXED_VOLTAGE (dtb 里的 fixed 供电) / MFD_SPMI_PMIC / SPMI
#   BLK_DEV_INITRD / TMPFS / EXT4_FS / CONFIGFS_FS / DEVTMPFS
#   USB_DWC3 / USB_GADGET / USB_CONFIGFS(+RNDIS+ACM) / EXTCON_USB_GPIO
#   WCN36XX=m / CFG80211=m / MAC80211=m (gen-kernel-config.sh 硬校验)
# =============================================================================

# --- 1. 平台: 只留 ARCH_QCOM ---
CONFIG_ARCH_ACTIONS=n
CONFIG_ARCH_AIROHA=n
CONFIG_ARCH_SUNXI=n
CONFIG_ARCH_ALPINE=n
CONFIG_ARCH_APPLE=n
CONFIG_ARCH_BCM=n
CONFIG_ARCH_BCM2835=n
CONFIG_ARCH_BCM_IPROC=n
CONFIG_ARCH_BCMBCA=n
CONFIG_ARCH_BRCMSTB=n
CONFIG_ARCH_BERLIN=n
CONFIG_ARCH_EXYNOS=n
CONFIG_ARCH_SPARX5=n
CONFIG_ARCH_K3=n
CONFIG_ARCH_LG1K=n
CONFIG_ARCH_HISI=n
CONFIG_ARCH_KEEMBAY=n
CONFIG_ARCH_MEDIATEK=n
CONFIG_ARCH_MESON=n
CONFIG_ARCH_MVEBU=n
CONFIG_ARCH_NXP=n
CONFIG_ARCH_LAYERSCAPE=n
CONFIG_ARCH_MXC=n
CONFIG_ARCH_S32=n
CONFIG_ARCH_MA35=n
CONFIG_ARCH_NPCM=n
CONFIG_ARCH_REALTEK=n
CONFIG_ARCH_RENESAS=n
CONFIG_ARCH_ROCKCHIP=n
CONFIG_ARCH_SEATTLE=n
CONFIG_ARCH_INTEL_SOCFPGA=n
CONFIG_ARCH_STM32=n
