CONFIG_INPUT_JOYDEV=n
CONFIG_INPUT_TABLET=n

# --- 12a. arm64 地址位宽: 强制 48-bit VA / 48-bit PA (对齐原厂 2.1) ---
# 原厂 boot-stock-2.1 的内核是 VA_BITS=48 / PA_BITS=48; 我们上一版是 52/52.
# msm8916 是 Cortex-A53 (ARMv8.0), 没有 LVA(52-bit VA) 能力, 52-bit 没有收益,
# 只会让内核多走一层 vabits_actual 回退分支, 增加不确定性.
# 注意: CONFIG_ARM64_VA_BITS 是 choice 派生的 int, 不能直接钉,
#       这里只钉 choice 符号; 最终 .config 的 VA_BITS=48 由
#       scripts/gen-kernel-config.sh 在 olddefconfig 之后硬校验.
CONFIG_ARM64_VA_BITS_48=y
CONFIG_ARM64_VA_BITS_52=n

# --- 12. USB: 只留 chipidea(gadget) + configfs(RNDIS/ACM) ---
# 重要: msm8916 主线 dtsi 的 usb@78d9000 是 compatible="qcom,ci-hdrc"
#       (ChipIdea, 配 qcom,usb-hs-phy-msm8916), 不是 dwc3.
#       USB_CHIPIDEA / _UDC / _HOST 必须保持 =y, 否则 USB 网卡和 ACM 全部消失.
CONFIG_USB_GADGET=y
CONFIG_USB_CHIPIDEA=y
CONFIG_USB_CHIPIDEA_UDC=y
CONFIG_USB_CHIPIDEA_HOST=y
CONFIG_USB_CHIPIDEA_MSM=y
# PHY 提到 =y: chipidea 是内建的, PHY 若为模块要等 userspace 加载,
# 开机早期 USB gadget 会一直 EPROBE_DEFER.
CONFIG_PHY_QCOM_USB_HS=y
# USB_PHY 是 PHY_QCOM_USB_HS 的依赖 (6.12 才有这个 bool, 5.15 无此符号;
# 写进 fragment 只是保证 =y, 若该分支没有这个符号, olddefconfig 会直接丢弃)
CONFIG_USB_PHY=y
CONFIG_USB_XHCI_HCD=n
CONFIG_USB_XHCI_PLATFORM=n
CONFIG_USB_XHCI_PCI=n
CONFIG_USB_EHCI_HCD=n
CONFIG_USB_EHCI_HCD_PLATFORM=n
CONFIG_USB_EHCI_FSL=n
