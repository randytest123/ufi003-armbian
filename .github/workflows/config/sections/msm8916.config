# =============================================================================
# MSM8916 (Qualcomm Snapdragon 410) — Armbian kernel config fragment
# 适用: UFI003 OpenStick (无 modem 版)
#
# 用法: Armbian build 框架会自动把此文件与 msm8916_defconfig merge
#       位置在 config/sources/families/msm8916.conf 里 KERNEL_CONFIG_FRAGMENTS+=()
#
# 主线 msm8916_defconfig 默认开启的 (不需要再写):
#   CONFIG_ARCH_QCOM=y
#   CONFIG_ARM64=y
#   CONFIG_SMP=y
#   CONFIG_HIGHMEM=y
#   CONFIG_BLK_DEV_INITRD=y
#   CONFIG_MODULES=y
#
# 主线 msm8916_defconfig 默认为 M 或不开启的 (需要手动开):
#
# =============================================================================

# --- WiFi (WCN3620) ---
# 主线 6.12+ 用 wcn36xx 驱动 (替代旧的 ath6kl)
CONFIG_CFG80211=m
CONFIG_CFG80211_WEXT=y
CONFIG_MAC80211=m
CONFIG_WCN36XX=m
CONFIG_WCN36XX_SDIO=y

# WiFi/BT 共用的 QCOM WCNSS remoteproc 子系统
# pronto-v2-pil 驱动负责加载 wcnss.b00~b11 firmware
CONFIG_QCOM_PRONTO=m
CONFIG_PHY_QCOM_WCNSS_QMI=m
CONFIG_SSMSM=y
CONFIG_QCOM_SMD=y
CONFIG_QCOM_SMD_REGULATOR=y

# remoteproc 子系统 (PIL = Peripheral Image Loader)
CONFIG_QCOM_PIL=y
CONFIG_QCOM_PIL_INFO=y
CONFIG_QCOM_ILLA=y
CONFIG_QCOM_Q6V5_PIL=y
CONFIG_REMOTEPROC=y

# SMD channel 驱动 (modem/SMD/QRTR 共用 — WiFi 也需要 SMD)
CONFIG_QCOM_SMD_SMEM=y
CONFIG_QCOM_QMI_HELPERS=y

# --- USB OTG / gadget ---
CONFIG_USB=y
CONFIG_USB_DWC3=y
CONFIG_USB_DWC3_GADGET=y
CONFIG_USB_CONFIGFS=y
CONFIG_USB_CONFIGFS_RNDIS=y
CONFIG_USB_CONFIGFS_F_ACM=y
CONFIG_USB_CONFIGFS_F_FS=y

# --- eMMC storage ---
CONFIG_MMC=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_SDHCI_PLTFM=y
CONFIG_MMC_CQ_HCI=y

# --- GPIO / pinmux / pinctrl ---
CONFIG_PINCTRL_QCOM_SPM_V2=y
CONFIG_PINCTRL_MSM8916=y
CONFIG_GPIO_MSM_V2=y

# --- regulators ---
CONFIG_REGULATOR_QCOM_SMD_RPM=y
CONFIG_REGULATOR_RPM_SMD=y

# --- serial console ---
CONFIG_SERIAL_MSM_GENI=y
CONFIG_SERIAL_MSM_GENI_CONSOLE=y

# --- Reset button / LEDs ---
CONFIG_INPUT=y
CONFIG_INPUT_KEYBOARD=y
CONFIG_KEYBOARD_GPIO=y
CONFIG_LEDS=y
CONFIG_LEDS_GPIO=y

# --- extcon (USB role detection) ---
CONFIG_EXTCON=y
CONFIG_EXTCON_GPIO=y

# --- 其他 ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_MANDATORY_FILE_LOCKING=y
CONFIG_AUTOFS4_FS=y
CONFIG_TMPFS_POSIX_ACL=y
CONFIG_OVERLAY_FS=y

# --- 调试用 (首次构建建议开, 以后可以关) ---
CONFIG_PRINTK_TIME=y
CONFIG_DEBUG_INFO_DWARF4=y
CONFIG_BLK_DEV_DM=y

# --- 刻意不开启的 (无 modem 版) ---
# CONFIG_QCOM_CSDISP is not set   ← modem SMS 通道
# CONFIG_QCOM_CSDPCONN is not set  ← modem 数据通道
# CONFIG_RPMSG_QCOM_GLINK_SMEM is not set ← 可选, WiFi SMD 不依赖这个
